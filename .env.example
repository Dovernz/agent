# ==============================================================================
# TEMPLATE CẤU HÌNH TÀI KHOẢN ĐĂNG NHẬP CHO AI AGENT (MẪU DÙNG CHUNG)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Copy file này thành file '.env':
#    cp .env.example .env
# 2. Điền thông tin tài khoản thật của bạn vào file '.env'.
# 3. File '.env' đã được đưa vào .gitignore để KHÔNG BAO GIỜ bị lộ lên GitHub.
# 4. Khi Agent duyệt vào domain nào, nó sẽ tự động tra cứu tài khoản tương ứng.
# ==============================================================================

# --- ĐẠI LÝ BÁN LẺ CÔNG NGHỆ ---
# HACOM (hacom.vn)
HACOM_USERNAME=user@example.com
HACOM_PASSWORD=your_hacom_password_here

# Phong Vũ (phongvu.vn)
PHONGVU_USERNAME=0912345678
PHONGVU_PASSWORD=your_phongvu_password_here

# GearVN (gearvn.com)
GEARVN_USERNAME=user@example.com
GEARVN_PASSWORD=your_gearvn_password_here

# An Phát PC (anphatpc.com.vn)
ANPHAT_USERNAME=user@example.com
ANPHAT_PASSWORD=your_anphat_password_here

# Nguyễn Công PC (nguyencongpc.vn)
NGUYENCONG_USERNAME=user@example.com
NGUYENCONG_PASSWORD=your_nguyencong_password_here

# KCCShop (kccshop.vn)
KCCSHOP_USERNAME=user@example.com
KCCSHOP_PASSWORD=your_kccshop_password_here

# --- CÁC NỀN TẢNG PHỔ THÔNG KHÁC ---
# GitHub (github.com)
GITHUB_USERNAME=your_github_username
GITHUB_PASSWORD=your_github_password_or_token

# Google / Portal / Internal Service (domain tuỳ biến)
# Cú pháp tự động nhận diện: <TÊN_DOMAIN>_USERNAME và <TÊN_DOMAIN>_PASSWORD
# Ví dụ trang: https://portal.company.com/login
# PORTAL_COMPANY_USERNAME=my_user
# PORTAL_COMPANY_PASSWORD=my_password
